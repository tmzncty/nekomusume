{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nekomusume.invalid/schema/canonical-vector.v1.json",
  "title": "Nekomusume canonical protocol vector corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "parent_commit", "freeze", "vectors"],
  "properties": {
    "schema": {"const": "nekomusume.canonical-vector.v1"},
    "schema_version": {"const": 1},
    "parent_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "freeze": {"const": false},
    "vectors": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/vector"}}
  },
  "$defs": {
    "hex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})*$", "maxLength": 8192},
    "vector": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "domain", "operation", "input", "bytes_hex", "expected", "oracle", "classification"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
        "domain": {"enum": ["negotiation", "wire", "frame", "ack", "reliable_udp", "datagram", "key_update", "carrier_transition", "close", "error"]},
        "operation": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
        "input": {"type": "object"},
        "bytes_hex": {"$ref": "#/$defs/hex"},
        "expected": {"type": "object", "additionalProperties": false, "required": ["ok"], "properties": {
          "ok": {"type": "boolean"},
          "value": {},
          "error": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9_.-]{1,95}$"}
        }, "allOf": [{"if": {"properties": {"ok": {"const": true}}}, "then": {"required": ["value"], "not": {"required": ["error"]}}}, {"if": {"properties": {"ok": {"const": false}}}, "then": {"required": ["error"], "not": {"required": ["value"]}}}]},
        "oracle": {"type": "object", "additionalProperties": false, "required": ["encode_equals_bytes", "decode_bytes_equals_expected", "roundtrip_equals_bytes"], "properties": {"encode_equals_bytes": {"const": true}, "decode_bytes_equals_expected": {"const": true}, "roundtrip_equals_bytes": {"const": true}}},
        "classification": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["valid", "malformed", "truncated", "trailing", "oversized", "unknown_enum", "unknown_version", "unauthenticated", "out_of_range", "integer_min", "integer_max", "integer_overflow", "noncanonical_integer", "duplicate", "late"]}}
      }
    }
  }
}
