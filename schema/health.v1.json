{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nekomusume.dev/schema/health.v1.json","title":"Nekomusume health snapshot v1","type":"object",
  "required":["schema","schema_version","generated_at_ms","status","session_id","active","metrics","event_buffer","human_summary"],
  "properties":{"schema":{"const":"nekomusume.health.v1"},"schema_version":{"const":1},"generated_at_ms":{"type":"integer","minimum":0},"status":{"enum":["ok","degraded","failed","unknown"]},"session_id":{"$ref":"#/$defs/id"},
    "active":{"type":"object","required":["carrier_id","path_id","carrier_kind"],"properties":{"carrier_id":{"$ref":"#/$defs/id"},"path_id":{"$ref":"#/$defs/id"},"carrier_kind":{"enum":["udp","tcp","icmp","raw_ip","other"]},"path_generation":{"$ref":"#/$defs/u"}},"additionalProperties":false},
    "metrics":{"type":"object","required":["rtt","loss","recovery","flow","scheduler","migration","key_update","resources"],"properties":{
      "rtt":{"type":"object","required":["latest_us","min_us","smoothed_us","variance_us"],"properties":{"latest_us":{"$ref":"#/$defs/nu"},"min_us":{"$ref":"#/$defs/nu"},"smoothed_us":{"$ref":"#/$defs/nu"},"variance_us":{"$ref":"#/$defs/nu"}},"additionalProperties":false},
      "loss":{"type":"object","required":["per_mille","packets_total","bytes_total"],"properties":{"per_mille":{"type":["integer","null"],"minimum":0,"maximum":1000},"packets_total":{"$ref":"#/$defs/u"},"bytes_total":{"$ref":"#/$defs/u"}},"additionalProperties":false},
      "recovery":{"type":"object","required":["pto_count","pto_total","retransmit_frames_total","retransmit_bytes_total"],"properties":{"pto_count":{"$ref":"#/$defs/u"},"pto_total":{"$ref":"#/$defs/u"},"retransmit_frames_total":{"$ref":"#/$defs/u"},"retransmit_bytes_total":{"$ref":"#/$defs/u"}},"additionalProperties":false},
      "flow":{"type":"object","required":["open_streams","session_queued_bytes","max_streams","max_session_bytes","max_stream_bytes","blocked_total"],"properties":{"open_streams":{"$ref":"#/$defs/u"},"session_queued_bytes":{"$ref":"#/$defs/u"},"max_streams":{"$ref":"#/$defs/u"},"max_session_bytes":{"$ref":"#/$defs/u"},"max_stream_bytes":{"$ref":"#/$defs/u"},"blocked_total":{"$ref":"#/$defs/u"}},"additionalProperties":false},
      "scheduler":{"type":"object","required":["interactive_dequeues_total","bulk_dequeues_total","starvation_guard_total","max_wait_us"],"properties":{"interactive_dequeues_total":{"$ref":"#/$defs/u"},"bulk_dequeues_total":{"$ref":"#/$defs/u"},"starvation_guard_total":{"$ref":"#/$defs/u"},"max_wait_us":{"$ref":"#/$defs/nu"}},"additionalProperties":false},
      "migration":{"type":"object","required":["attempts_total","validated_total","completed_total","rejected_total","switches_total","last_recovery_latency_us","duplicate_bytes_total","delivered_bytes_total"],"properties":{"attempts_total":{"$ref":"#/$defs/u"},"validated_total":{"$ref":"#/$defs/u"},"completed_total":{"$ref":"#/$defs/u"},"rejected_total":{"$ref":"#/$defs/u"},"switches_total":{"$ref":"#/$defs/u"},"last_recovery_latency_us":{"$ref":"#/$defs/nu"},"duplicate_bytes_total":{"$ref":"#/$defs/u"},"delivered_bytes_total":{"$ref":"#/$defs/u"}},"additionalProperties":false},
      "key_update":{"type":"object","required":["current_phase","started_total","completed_total","rejected_total","last_result"],"properties":{"current_phase":{"$ref":"#/$defs/u"},"started_total":{"$ref":"#/$defs/u"},"completed_total":{"$ref":"#/$defs/u"},"rejected_total":{"$ref":"#/$defs/u"},"last_result":{"enum":["never","succeeded","rejected"]}},"additionalProperties":false},
      "resources":{"type":"object","required":["sent_packets","uncertain_entries","uncertain_bytes","health_paths","memory_bytes"],"properties":{"sent_packets":{"$ref":"#/$defs/gauge"},"uncertain_entries":{"$ref":"#/$defs/gauge"},"uncertain_bytes":{"$ref":"#/$defs/gauge"},"health_paths":{"$ref":"#/$defs/gauge"},"memory_bytes":{"$ref":"#/$defs/nullableGauge"}},"additionalProperties":false}
    },"additionalProperties":false},
    "event_buffer":{"type":"object","required":["capacity","retained","oldest_sequence","newest_sequence","dropped_total"],"properties":{"capacity":{"type":"integer","minimum":1,"maximum":1024},"retained":{"type":"integer","minimum":0,"maximum":1024},"oldest_sequence":{"$ref":"#/$defs/nu"},"newest_sequence":{"$ref":"#/$defs/nu"},"dropped_total":{"$ref":"#/$defs/u"}},"additionalProperties":false},
    "human_summary":{"type":"string","minLength":1,"maxLength":512,"pattern":"^[^\\r\\n]*$"}
  },"additionalProperties":false,
  "$defs":{"id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},"u":{"type":"integer","minimum":0},"nu":{"type":["integer","null"],"minimum":0},"gauge":{"type":"object","required":["current","limit"],"properties":{"current":{"$ref":"#/$defs/u"},"limit":{"$ref":"#/$defs/u"}},"additionalProperties":false},"nullableGauge":{"type":"object","required":["current","limit"],"properties":{"current":{"$ref":"#/$defs/nu"},"limit":{"$ref":"#/$defs/nu"}},"additionalProperties":false}}
}
