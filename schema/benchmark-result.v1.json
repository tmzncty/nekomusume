{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nekomusume.dev/schema/benchmark-result.v1.json",
  "title": "Nekomusume bounded benchmark result",
  "type": "object",
  "required": [
    "schema",
    "experiment_id",
    "git_commit",
    "mode",
    "transport",
    "scope",
    "samples",
    "summary",
    "cleanup_status"
  ],
  "properties": {
    "schema": {
      "const": "nekomusume.benchmark-result.v1"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{8,64}$"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "mode": {
      "type": "string"
    },
    "transport": {
      "enum": [
        "tcp",
        "udp",
        "deterministic",
        "netns"
      ]
    },
    "scope": {
      "type": "string"
    },
    "bounds": {
      "type": "object",
      "required": [
        "maximum_duration_ms",
        "application_bytes_max"
      ],
      "properties": {
        "maximum_duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "application_bytes_max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "failures"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "failures": {
            "type": "integer",
            "minimum": 0
          },
          "median_exchange_latency_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "p95_exchange_latency_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "application_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "wire_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "implementation",
          "failures"
        ],
        "properties": {
          "implementation": {
            "type": "string"
          },
          "failures": {
            "type": "integer",
            "minimum": 0
          },
          "median_exchange_latency_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "p95_exchange_latency_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "successful_latency_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "p95_latency_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "application_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "wire_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "cleanup_status": {
      "enum": [
        "verified",
        "failed",
        "not_applicable"
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 32
    },
    "cleanup_evidence": {
      "type": "object",
      "required": [
        "local_processes_reaped",
        "local_listeners_remaining",
        "remote_process_groups_reaped",
        "remote_listeners_remaining",
        "remote_temp_path_removed"
      ],
      "properties": {
        "local_processes_reaped": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "local_listeners_remaining": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "remote_process_groups_reaped": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "remote_listeners_remaining": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "remote_temp_path_removed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
