{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nekomusume.dev/schema/diagnostic-bundle.v1.json","title":"Nekomusume bounded diagnostic bundle v1","type":"object",
  "required":["schema","schema_version","bundle_id","generated_at_ms","capture","source","health","events","negative_evidence","redaction"],
  "properties":{"schema":{"const":"nekomusume.diagnostic-bundle.v1"},"schema_version":{"const":1},"bundle_id":{"$ref":"#/$defs/id"},"generated_at_ms":{"type":"integer","minimum":0},
    "capture":{"type":"object","required":["started_at_ms","ended_at_ms","complete","max_events","max_bundle_bytes"],"properties":{"started_at_ms":{"type":"integer","minimum":0},"ended_at_ms":{"type":"integer","minimum":0},"complete":{"type":"boolean"},"max_events":{"type":"integer","minimum":1,"maximum":1024},"max_bundle_bytes":{"type":"integer","minimum":1,"maximum":8388608}},"additionalProperties":false},
    "source":{"type":"object","required":["git_commit","component","component_version"],"properties":{"git_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"component":{"enum":["neko-cli","neko-client","neko-server","neko-carrier","neko-session"]},"component_version":{"type":"string","minLength":1,"maxLength":64}},"additionalProperties":false},
    "health":{"$ref":"health.v1.json"},"events":{"type":"array","maxItems":1024,"items":{"$ref":"observability-event.v1.json"}},
    "negative_evidence":{"type":"array","maxItems":128,"items":{"type":"object","required":["claim","status","producer","started_at_ms","ended_at_ms","completeness","reason"],"properties":{"claim":{"type":"string","pattern":"^[a-z0-9_.-]{1,96}$"},"status":{"enum":["observed_absent","not_observed","buffer_gap","not_applicable"]},"producer":{"type":"string","pattern":"^[a-z0-9_.-]{1,64}$"},"started_at_ms":{"type":"integer","minimum":0},"ended_at_ms":{"type":"integer","minimum":0},"completeness":{"enum":["complete","partial","none"]},"reason":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\r\\n]*$"}},"additionalProperties":false}},
    "redaction":{"type":"object","required":["policy","secret_fields_removed","payload_bodies_included","endpoint_locators_included"],"properties":{"policy":{"const":"nekomusume.secret-free.v1"},"secret_fields_removed":{"type":"integer","minimum":0},"payload_bodies_included":{"const":false},"endpoint_locators_included":{"const":false}},"additionalProperties":false}
  },"additionalProperties":false,"$defs":{"id":{"type":"string","minLength":8,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"}}
}
